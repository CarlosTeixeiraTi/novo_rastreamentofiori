<mvc:View
	controllerName="br.com.smartpcm.rastreamento.zrastreio.controller.Mapa"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%">

	<Page
		id="pagina"
		showHeader="false"
		enableScrolling="false">
		<content>
			<VBox height="100%" fitContainer="true">
				<OverflowToolbar class="sapUiTinyMarginBegin sapUiTinyMarginEnd">
					<SearchField id="buscaMapa" width="18rem" placeholder="{i18n>mapaBuscar}"
						search=".onBuscarNoMapa" />
					<ToggleButton id="btnCercas" text="{i18n>mapaCercasBtn}" pressed="true"
						press=".onAlternarCercas" />
					<ToggleButton id="btnGateways" text="{i18n>mapaGatewaysBtn}" pressed="true"
						press=".onAlternarGateways" />
					<!-- Liga/desliga os nomes de bairro, municipio e unidade.
					     Sem isto, em zoom aberto os rotulos cobrem os alfinetes. -->
					<ToggleButton id="btnLegendas" icon="sap-icon://text-align-left"
						text="{i18n>mapaLegendas}" pressed="true" press=".onAlternarLegendas" />
					<ToolbarSpacer />
					<SegmentedButton id="segBase" selectedKey="{config>/mapa/base}"
						selectionChange=".onTrocarBase">
						<items>
							<SegmentedButtonItem key="claro" text="{i18n>mapaBaseClaro}" />
							<SegmentedButtonItem key="satelite" text="{i18n>mapaBaseSatelite}" />
						</items>
					</SegmentedButton>
					<Button icon="sap-icon://exit-full-screen" type="Transparent"
						tooltip="{i18n>mapaReduzir}" press=".onReduzir" />
				</OverflowToolbar>

				<HBox height="100%" fitContainer="true">
					<core:HTML id="mapaCheio"
						content="&lt;div class=&quot;valeMapa&quot; style=&quot;height:100%;min-height:520px&quot;&gt;&lt;/div&gt;" />
					<VBox width="20rem" class="valeCartao sapUiTinyMarginBegin"
						visible="{= !!${tela>/selecionado} }">
						<VBox class="sapUiSmallPadding">
							<Title text="{tela>/selecionado/codigoOriginal}" level="H3"
								titleStyle="H5" class="valeMono" />
							<Text text="{tela>/selecionado/descricao}" class="valeKpiPe" />
						</VBox>
						<List showSeparators="Inner"
							class="sapUiSmallPaddingBegin sapUiSmallPaddingEnd">
							<DisplayListItem label="{i18n>detSituacao}"
								value="{tela>/selecionado/grupoAtual}" />
							<DisplayListItem label="{i18n>detLocal}"
								value="{tela>/selecionado/local}" />
							<DisplayListItem label="{i18n>detOficina}"
								value="{tela>/selecionado/oficina}" />
							<DisplayListItem label="{i18n>detGateway}"
								value="{tela>/selecionado/gateway}" />
							<DisplayListItem label="{i18n>detComunicacao}"
								value="{tela>/selecionado/silencioTexto}" />
							<DisplayListItem label="{i18n>detConfianca}"
								value="{tela>/selecionado/confianca}" />
						</List>
						<Button text="{i18n>detAbrirFicha}" type="Emphasized" press=".onAbrirFicha"
							class="sapUiSmallMargin" />
					</VBox>
				</HBox>
			</VBox>
		</content>
	</Page>
</mvc:View>