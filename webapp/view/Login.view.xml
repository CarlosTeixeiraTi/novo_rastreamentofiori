<mvc:View
    controllerName="br.com.smartpcm.rastreamento.zrastreio.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        showHeader="false"
        backgroundDesign="Transparent"
        class="loginBackground">

        <content>

            <VBox
                width="100%"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                backgroundDesign="Transparent">

                <!-- ALTERADO: width aumentado de 500px     para 600px -->
                <Panel
                    width="420px"
                    accessibleRole="Form"
                    backgroundDesign="Solid"
                    class="sapUiResponsivePadding fonteCustomizada">

                    <content>

                        <!-- Cabeçalho -->
                        <VBox
                            alignItems="Stretch"
                            class="sapUiSmallMarginBottom sapUiSmallMarginTop">

                            <!-- Alinhamento da Imagem à Direita -->
                            <HBox justifyContent="Center" width="100%">
                                <Image
                                    src="img/vale.png"
                                    width="60px"
                                    class="sapUiSmallMarginBottom" />
                            </HBox>

                            <!-- Títulos Centralizados -->
                            <VBox alignItems="Center" width="100%">
                                <Title
                                    text="Rastreamento de Componentes"
                                    level="H2"
                                    class="tituloLogin" />

                                <Text
                                    text="COORD MAN DIGITAL GEST ATIVOS"
                                    class="subtituloLogin" />
                            </VBox>

                        </VBox>
                        <!-- Rodapé -->
                        <Text
                            text=""
                            width="100%"
                            textAlign="Center"
                            class="sapUiSmallMarginTop subtituloLogin" />
                        <Text
                            text=""
                            width="100%"
                            textAlign="Center"
                            class="sapUiSmallMarginTop subtituloLogin" />

                        <!-- Usuário -->
                        <Label
                            text="Usuário"
                            required="true"
                            class="sapUiTinyMarginBottom labelLogin" />

                        <Input
                            id="idUsuario"
                            placeholder="Digite sua matrícula"
                            class="sapUiSmallMarginBottom inputLogin" />

                        <!-- Senha -->
                        <Label
                            text="Senha"
                            required="true"
                            class="sapUiTinyMarginBottom labelLogin" />

                        <Input
                            id="idSenha"
                            type="Password"
                            placeholder="Digite sua senha"
                            class="inputLogin" />


                        <VBox
                            width="100%"
                            alignItems="Stretch"
                            class="sapUiMediumMarginTop sapUiTinyMarginBottom">

                            <Button
                                text="Entrar"
                                width="100%"
                                type="Emphasized"
                                class="loginButton"
                                press="onEntrarPress" />
                            <Text
                                text=""
                                width="100%"
                                textAlign="Center"
                                class="sapUiSmallMarginTop subtituloLogin" />
                            <Text
                                text=""
                                width="100%"
                                textAlign="Center"
                                class="sapUiSmallMarginTop subtituloLogin" />


                        </VBox>


                    </content>


                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>